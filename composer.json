{
    "name": "megabuilder/megabuilder",
    "description": "Mega Builder visual page builder module for PrestaShop 8 and 9 (development tooling only; the module itself has no Composer dependencies).",
    "type": "prestashop-module",
    "license": "AFL-3.0",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "MegaBuilder\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find . -path ./vendor -prune -o -path ./node_modules -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    }
}
